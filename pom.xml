<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The Spring Boot parent supplies dependency versions, plugin versions,
       and - load-bearing here - the -parameters compiler flag. Jackson needs
       constructor parameter names to deserialise Folder, which has a single
       argument constructor and no no-arg constructor. Drop the parent and
       Folder stops round-tripping in a way that looks unrelated to the change. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>ca.zubairm</groupId>
  <artifactId>command-quest</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <name>command-quest</name>
  <url>https://github.com/zubairmuwwakil/command-quest</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The parent defaults java.version to 17 and derives
         maven.compiler.release from it. 17 is a floor, not a ceiling. -->
    <java.version>25</java.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The BOM pins every junit-* artifact to one version, so the api,
           params, and engine dependencies below need no <version> of their
           own and cannot drift apart. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Embedded Tomcat + Spring MVC + Jackson. This is what turns the domain
         into an HTTP API; nothing in commands/ or hub/ depends on it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean Validation, so a malformed request becomes a 400 with a clean
         message rather than a stack trace. The client supplies the folder
         tree in this design, which makes it untrusted input. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spring Boot 4 split the test slices into per-technology modules, so
         @WebMvcTest is no longer pulled in by spring-boot-starter-test. Without
         this the annotation simply does not resolve. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Optionally: parameterized tests support -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Runs the tests. Without an engine on the test classpath the suite can
         silently report "no tests to run". -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement><!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <!-- default lifecycle, jar packaging: see https://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_jar_packaging -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.3.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <!-- site lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#site_Lifecycle -->
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.12.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Repackages the jar so it carries its dependencies and a Main-Class.
           The parent supplies this plugin's VERSION but does not run it -
           inheriting a parent manages plugins, it does not activate them.
           Without this declaration "package" produces a 38 KB jar with no
           manifest entry and "java -jar" fails with "no main manifest
           attribute".

           mainClass is explicit because this jar has two: the console App and
           the web application. Auto-detection fails when there is more than
           one, which is the price of keeping both front ends alive.

           The same jar still runs the console game, verified:
             java -cp target/command-quest-0.0.1-SNAPSHOT.jar \
                  -Dloader.main=ca.zubairm.command_quest.App \
                  org.springframework.boot.loader.launch.PropertiesLauncher -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>ca.zubairm.command_quest.web.CommandQuestApplication</mainClass>
        </configuration>
      </plugin>

      <!-- Measures how much of the code the tests actually execute.
           Run "./mvnw clean test" then open target/site/jacoco/index.html
           0.8.15+ is required to read Java 25 bytecode (class file major
           version 69); older releases fail with "Unsupported class file
           major version". -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
